# Claude Code per-machine config + memory. Allow-lists in here have
# previously contained literal API tokens — keep it out of source control.
.claude/

# Auth artefact — encrypted JWT bundle stored under userData; should
# never escape the dev machine even if a copy ends up in the repo dir.
auth-token.bin

# Generated platform icons (built from public/icon.png by scripts/build-icons.js).
public/icon.ico
public/icon.icns

