VITE_PREVIEW_API_URL=https://pipilot.dev/api/app-preview
VITE_PREVIEW_API_KEY=Bearer ppk_live_pipilot_preview_2026

# Claude Agent SDK configuration
ANTHROPIC_BASE_URL=https://the3rdacademy.com/api
ANTHROPIC_AUTH_TOKEN=sk-praxis-placeholder
ANTHROPIC_API_KEY=sk-ant-api03-placeholder-key-for-sdk-validation-only

# Model overrides
ANTHROPIC_DEFAULT_SONNET_MODEL=claude-sonnet-4-6
ANTHROPIC_DEFAULT_SONNET_MODEL_NAME=Claude Sonnet 4.6
ANTHROPIC_DEFAULT_OPUS_MODEL=claude-sonnet-4-6
ANTHROPIC_DEFAULT_OPUS_MODEL_NAME=Claude Sonnet 4.6
ANTHROPIC_DEFAULT_HAIKU_MODEL=claude-sonnet-4-6
ANTHROPIC_DEFAULT_HAIKU_MODEL_NAME=Claude Sonnet 4.6

# Remote/headless flag for Claude Code
CLAUDE_CODE_REMOTE=true

# Playwright
PLAYWRIGHT_BROWSERS_PATH=0

# Voice input — speech-to-text (Groq primary, Cloudflare fallback)
GROQ_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Codestral — inline completions + inline chat
CODESTRAL_API_KEY=
CODESTRAL_HOST=codestral.mistral.ai
CODESTRAL_MODEL=codestral-latest
